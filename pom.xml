	<profiles>
		<!-- Use -Pjava8, -Pjava11, -Pjava17, or -Pjava21. Explicit -P wins; only that profile is active. -->
		<!-- add-opens required for Java 17+ only (CGLib/reflection) -->
		<profile>
			<id>java21</id>
			<properties>
				<logviewer.profile>java21</logviewer.profile>
				<logviewer.artifact>io.neba.neba-logviewer</logviewer.artifact>
				<enforcer.java.version>[21,)</enforcer.java.version>
				<surefire.addOpens>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED -Djdk.attach.allowAttachSelf=true</surefire.addOpens>
				<language.level>21</language.level>
				<maven.compiler.release>21</maven.compiler.release>
			</properties>
		</profile>
		<profile>
			<id>java17</id>
			<properties>
				<logviewer.profile>java17</logviewer.profile>
				<logviewer.artifact>io.neba.neba-logviewer</logviewer.artifact>
				<enforcer.java.version>[17,)</enforcer.java.version>
				<surefire.addOpens>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED -Djdk.attach.allowAttachSelf=true</surefire.addOpens>
				<language.level>17</language.level>
				<maven.compiler.release>17</maven.compiler.release>
			</properties>
		</profile>
		<profile>
			<id>java11</id>
			<properties>
				<logviewer.profile>java11</logviewer.profile>
				<logviewer.artifact>io.neba.neba-logviewer</logviewer.artifact>
				<enforcer.java.version>[11,)</enforcer.java.version>
				<surefire.addOpens>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.lang.reflect=ALL-UNNAMED -Djdk.attach.allowAttachSelf=true</surefire.addOpens>
				<language.level>11</language.level>
				<maven.compiler.release>11</maven.compiler.release>
			</properties>
		</profile>
		<!-- Mockito 5 requires Java 11+; use Mockito 4 for Java 8 builds -->
		<!-- Default when no -P specified. Run with Java 11+: mvn -Pjava11 clean verify -->
		<profile>
			<id>java8</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<logviewer.profile>java8</logviewer.profile>
				<logviewer.artifact>io.neba.neba-logviewer</logviewer.artifact>
				<enforcer.java.version>[1.8,)</enforcer.java.version>
				<language.level>8</language.level>
				<maven.compiler.release>8</maven.compiler.release>
				<!-- Java 8 does not support add-opens JVM option -->
				<surefire.addOpens></surefire.addOpens>
			</properties>
			<dependencyManagement>
				<dependencies>
					<dependency>
						<groupId>org.mockito</groupId>
						<artifactId>mockito-core</artifactId>
						<version>4.11.0</version>
					</dependency>
					<dependency>
						<groupId>net.bytebuddy</groupId>
						<artifactId>byte-buddy</artifactId>
						<version>1.12.19</version>
					</dependency>
				</dependencies>
			</dependencyManagement>
		</profile>
		<profile>
			<id>compile</id>
			<modules>
				<module>api-tld</module>
				<module>api</module>
				<module>core</module>
				<module>logviewer</module>
				<module>spring</module>
				<module>delivery-aem</module>
				<module>delivery-sling</module>
			</modules>
		</profile>
		<profile>
			<!-- from http://repo1.maven.org/maven2/org/sonatype/oss/oss-parent/7/oss-parent-7.pom -->
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<artifactId>maven-gpg-plugin</artifactId>
					</plugin>
					<plugin>
						<artifactId>maven-javadoc-plugin</artifactId>
					</plugin>
					<plugin>
						<artifactId>maven-source-plugin</artifactId>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

